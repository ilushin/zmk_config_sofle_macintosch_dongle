config SHIELD_RIGHT_TRACKPOINT_DONGLE
    def_bool $(shields_list_contains,right_trackpoint_dongle)

menu "TrackPoint Advanced Settings"

config TRACKPOINT_LOG_LEVEL
    int "TrackPoint log level (0=off, 1=error, 2=warning, 3=info, 4=debug)"
    default 2
    range 0 4

config TRACKPOINT_EXPONENTIAL
    bool "Enable TrackPoint exponential acceleration"
    default y

config TRACKPOINT_SCROLL_X_DIR
    int "Scroll X direction multiplier"
    default 1
    range -1 1

config TRACKPOINT_SCROLL_Y_DIR
    int "Scroll Y direction multiplier"
    default 1
    range -1 1

config TRACKPOINT_SCROLL_DEADZONE
    int "Scroll deadzone"
    default 2
    range 0 32

config TRACKPOINT_SCROLL_INPUT_MAX
    int "Scroll input maximum"
    default 128
    range 1 255

config TRACKPOINT_SCROLL_DIVISOR_SLOW
    int "Slow scroll divisor"
    default 60
    range 1 255

config TRACKPOINT_SCROLL_DIVISOR_FAST
    int "Fast scroll divisor"
    default 8
    range 1 255

config TRACKPOINT_DOMINANT_NUMERATOR
    int "Dominant axis numerator"
    default 3
    range 1 16

config TRACKPOINT_DOMINANT_DENOMINATOR
    int "Dominant axis denominator"
    default 2
    range 1 16

config TRACKPOINT_MOUSE_BASE_SPEED_PERCENT
    int "Mouse base speed percentage"
    default 50
    range 10 400

config TRACKPOINT_MOUSE_SENS_BASE_PERCENT
    int "Mouse sensitivity base percentage"
    default 30
    range 0 400

config TRACKPOINT_MOUSE_SENS_STEP_PERCENT
    int "Mouse sensitivity step per LED brightness"
    default 1
    range 0 20

endmenu
